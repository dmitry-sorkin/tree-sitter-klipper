{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "klipper",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "section"
          },
          {
            "type": "SYMBOL",
            "name": "comment"
          }
        ]
      }
    },
    "section": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "["
          },
          {
            "type": "FIELD",
            "name": "name",
            "content": {
              "type": "SYMBOL",
              "name": "section_name"
            }
          },
          {
            "type": "STRING",
            "value": "]"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "section_item"
            }
          }
        ]
      }
    },
    "section_name": {
      "type": "PATTERN",
      "value": "[A-Za-z0-9_ \\-./]+"
    },
    "section_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PREC_DYNAMIC",
          "value": 1,
          "content": {
            "type": "SYMBOL",
            "name": "gcode_block"
          }
        },
        {
          "type": "SYMBOL",
          "name": "setting"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "line_comment"
          },
          "named": true,
          "value": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "save_config_line"
        }
      ]
    },
    "setting": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "setting_key"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "[ \\t]+"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "separator",
          "content": {
            "type": "SYMBOL",
            "name": "setting_separator"
          }
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "value_text"
          }
        }
      ]
    },
    "setting_key": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_.-]*"
    },
    "setting_separator": {
      "type": "PATTERN",
      "value": "[=:]"
    },
    "value_text": {
      "type": "PATTERN",
      "value": "[^\\n\\r]+"
    },
    "gcode_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "gcode"
        },
        {
          "type": "FIELD",
          "name": "separator",
          "content": {
            "type": "SYMBOL",
            "name": "setting_separator"
          }
        },
        {
          "type": "FIELD",
          "name": "first_line",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "IMMEDIATE_TOKEN",
                    "content": {
                      "type": "PATTERN",
                      "value": "[ \\t]+"
                    }
                  },
                  {
                    "type": "SYMBOL",
                    "name": "gcode_line_content"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "gcode_line"
          }
        }
      ]
    },
    "gcode_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "PATTERN",
              "value": "\\n[ \\t]+"
            }
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "gcode_line_content"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "gcode_line_content": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PREC",
                  "value": 2,
                  "content": {
                    "type": "PATTERN",
                    "value": "\\{%[^}%]*%\\}"
                  }
                }
              },
              "named": true,
              "value": "jinja_tag"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PREC",
                  "value": 2,
                  "content": {
                    "type": "PATTERN",
                    "value": "\\{\\{[^}]*\\}\\}"
                  }
                }
              },
              "named": true,
              "value": "jinja_expression"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PREC",
                  "value": 2,
                  "content": {
                    "type": "PATTERN",
                    "value": "\\{#[\\s\\S]*?#\\}"
                  }
                }
              },
              "named": true,
              "value": "jinja_comment"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PREC",
                  "value": 2,
                  "content": {
                    "type": "PATTERN",
                    "value": "\\{action_[a-z_]+\\([^}]*\\)\\}"
                  }
                }
              },
              "named": true,
              "value": "klipper_action"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PREC",
                  "value": 3,
                  "content": {
                    "type": "PATTERN",
                    "value": "[#;][^\\n]*"
                  }
                }
              },
              "named": true,
              "value": "gcode_line_comment"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PREC",
                  "value": 3,
                  "content": {
                    "type": "PATTERN",
                    "value": "[A-Z][A-Z0-9_]*|[0-9]+(\\.[0-9]+)?|\"[^\"\\n]*\""
                  }
                }
              },
              "named": true,
              "value": "gcode_word"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "PREC",
                  "value": 1,
                  "content": {
                    "type": "PATTERN",
                    "value": "[ \\t]+|[^A-Z{#;%\\s\\n0-9][^A-Z0-9\\n]*"
                  }
                }
              },
              "named": true,
              "value": "gcode_text"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "ALIAS",
                "content": {
                  "type": "IMMEDIATE_TOKEN",
                  "content": {
                    "type": "PREC",
                    "value": 2,
                    "content": {
                      "type": "PATTERN",
                      "value": "\\{%[^}%]*%\\}"
                    }
                  }
                },
                "named": true,
                "value": "jinja_tag"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "IMMEDIATE_TOKEN",
                  "content": {
                    "type": "PREC",
                    "value": 2,
                    "content": {
                      "type": "PATTERN",
                      "value": "\\{\\{[^}]*\\}\\}"
                    }
                  }
                },
                "named": true,
                "value": "jinja_expression"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "IMMEDIATE_TOKEN",
                  "content": {
                    "type": "PREC",
                    "value": 2,
                    "content": {
                      "type": "PATTERN",
                      "value": "\\{#[\\s\\S]*?#\\}"
                    }
                  }
                },
                "named": true,
                "value": "jinja_comment"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "IMMEDIATE_TOKEN",
                  "content": {
                    "type": "PREC",
                    "value": 2,
                    "content": {
                      "type": "PATTERN",
                      "value": "\\{action_[a-z_]+\\([^}]*\\)\\}"
                    }
                  }
                },
                "named": true,
                "value": "klipper_action"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "IMMEDIATE_TOKEN",
                  "content": {
                    "type": "PREC",
                    "value": 3,
                    "content": {
                      "type": "PATTERN",
                      "value": "[#;][^\\n]*"
                    }
                  }
                },
                "named": true,
                "value": "gcode_line_comment"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "IMMEDIATE_TOKEN",
                  "content": {
                    "type": "PREC",
                    "value": 3,
                    "content": {
                      "type": "PATTERN",
                      "value": "[A-Z][A-Z0-9_]*|[0-9]+(\\.[0-9]+)?|\"[^\"\\n]*\""
                    }
                  }
                },
                "named": true,
                "value": "gcode_word"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "IMMEDIATE_TOKEN",
                  "content": {
                    "type": "PREC",
                    "value": 1,
                    "content": {
                      "type": "PATTERN",
                      "value": "[ \\t]+|[^A-Z{#;%\\s\\n0-9][^A-Z0-9\\n]*"
                    }
                  }
                },
                "named": true,
                "value": "gcode_text"
              }
            ]
          }
        }
      ]
    },
    "jinja_tag": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "\\{%[^}%]*%\\}"
        }
      }
    },
    "jinja_expression": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "\\{\\{[^}]*\\}\\}"
        }
      }
    },
    "jinja_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "\\{#[\\s\\S]*?#\\}"
        }
      }
    },
    "klipper_action": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "\\{action_[a-z_]+\\([^}]*\\)\\}"
        }
      }
    },
    "gcode_line_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "[#;][^\\n]*"
        }
      }
    },
    "gcode_word": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[A-Z][A-Z0-9_]*|[0-9]+(\\.[0-9]+)?"
        }
      }
    },
    "gcode_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]+|[^A-Z{#;%\\s\\n][^A-Z\\n]*"
        }
      }
    },
    "comment": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "save_config_line"
        },
        {
          "type": "SYMBOL",
          "name": "line_comment"
        }
      ]
    },
    "line_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[#;][^\\n]*"
      }
    },
    "save_config_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "#\\*#[^\\n]*"
        }
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}